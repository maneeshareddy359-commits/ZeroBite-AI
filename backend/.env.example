SECRET_KEY=change-this-in-development
DEBUG=True
# SQLite is the easiest Windows demo option. Use mysql for MySQL.
DB_ENGINE=sqlite
SQLITE_NAME=zerobite.sqlite3
# MySQL settings are used only when DB_ENGINE=mysql
DB_NAME=zerobite_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ORIGINS=http://localhost:5173
